# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.python-version

# Env / secrets
.env

# Data (regenerated by the pipeline, cacheable but not tracked)
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model artifacts (large binaries)
outputs/models/*.joblib
outputs/models/*.pkl
!outputs/models/.gitkeep

# Diagnostic-experiment model checkpoints (regenerable via scripts/diagnostics/*.py;
# large binaries, not meant to be tracked -- same policy as outputs/models/ above)
outputs/diagnostics_compression/experiments/models/*.joblib

# OS / editor
.DS_Store
.ipynb_checkpoints/
