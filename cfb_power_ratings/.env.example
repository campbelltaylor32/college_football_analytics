CFB_DB_HOST=localhost
CFB_DB_PORT=3306
CFB_DB_USER=root
CFB_DB_PASSWORD=
CFB_DB_NAME=cfb_football

# CFBD_API_KEY is read from the REPO ROOT's .env (see ../.env.example), not this file --
# only needed for scripts/update_ratings.py's live schedule pull (games/betting_lines in the
# MySQL DB above are completed-games-only, so an upcoming week's matchups always require a
# live CFBD API call).
