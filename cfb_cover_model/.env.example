# Copy to .env (gitignored). CFBD_API_KEY itself lives in the REPO ROOT's .env, not here -
# see ../.env.example and docker-compose.yml's env_file list (both are loaded).

# "The most recent completed season/week" - manually bumped weekly, same convention as the
# R pipeline's week_update/week variables. Bumping requires `docker compose restart scheduler`.
PRODUCTION_SEASON=2026
PRODUCTION_WEEK=3

# When the scheduler's weekly job fires (UTC). Common CFB weeks wrap up Saturday night /
# early Sunday, so Tuesday gives games and betting-line settlement time to finalize.
SCHEDULE_DAY_OF_WEEK=tue
SCHEDULE_HOUR=6

# Internal docker-compose network address the scheduler uses to call the API's /admin/retrain.
API_BASE_URL=http://api:8000

# Shared secret for POST /admin/retrain - proportionate for a local-only deployment, NOT
# internet-safe auth. Change from the default before exposing port 8000 beyond localhost.
ADMIN_API_TOKEN=changeme

# Prediction-drift alerting: how many recent weeks to average before comparing against the
# baseline, and how far below baseline (in precision) triggers alert=true.
PREDICTION_DRIFT_WINDOW_WEEKS=4
PREDICTION_DRIFT_ALERT_DELTA=0.10

# How many trained artifact versions to keep under outputs/models/production/ (each retrain
# prunes older ones beyond this count).
PRODUCTION_ARTIFACT_RETENTION=8
